{
  "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
  "format": 1,
  "name": "Dragon Quest IX Modern",
  "repo": "romusan495/Dragon-Quest-IX-Modern",
  "game": {
    "kind": "iso",
    "label": "Your own Dragon Quest IX ROM (.nds, or a .zip holding it), dumped from your DS cartridge: the European (YDQP) or USA (YDQE) version."
  },
  "prepare": {
    "program": [
      "BUILD.bat"
    ],
    "args": [
      "--prepare",
      "{game}"
    ],
    "label": "Building the PC game from your ROM (the first time installs MSYS2 and takes 10-20 minutes)",
    "timeout": 3600
  },
  "start": {
    "program": [
      "game/dqix.exe"
    ]
  },
  "config": [
    {
      "id": "main",
      "format": "ini",
      "file": [
        {
          "path": "{install}/game/settings.ini"
        }
      ],
      "new": {
        "settings_version": "3"
      }
    }
  ],
  "saves": [
    "{install}/game/dqix.sav",
    "{install}/game/save-backups",
    "{install}/game/settings.ini",
    "{install}/game/controls.ini"
  ],
  "folders": {
    "saves": [
      {
        "path": "{install}/game"
      }
    ],
    "logs": [
      {
        "path": "{install}/game"
      }
    ],
    "reports": [
      {
        "path": "{install}/game/reports"
      }
    ]
  },
  "settings": [
    {
      "id": "window",
      "label": "Window",
      "help": "Full screen or a window (F11 switches in the game).",
      "choices": [
        {
          "label": "Windowed",
          "set": {
            "fullscreen": "0"
          }
        },
        {
          "label": "Full screen",
          "set": {
            "fullscreen": "1"
          }
        }
      ],
      "defaults": {
        "fullscreen": "0"
      }
    },
    {
      "id": "mode",
      "label": "Graphics",
      "help": "Enhanced draws the 3D sharper on the graphics card; Classic is exactly like the DS (F5 switches).",
      "choices": [
        {
          "label": "Enhanced",
          "set": {
            "mode": "enhanced"
          }
        },
        {
          "label": "Classic",
          "set": {
            "mode": "classic"
          }
        }
      ],
      "defaults": {
        "mode": "enhanced"
      }
    },
    {
      "id": "language",
      "label": "Language",
      "help": "The game's language. Only the European version has the five; the USA version is always in English.",
      "choices": [
        {
          "label": "English",
          "set": {
            "language": "english"
          }
        },
        {
          "label": "Français",
          "set": {
            "language": "french"
          }
        },
        {
          "label": "Deutsch",
          "set": {
            "language": "german"
          }
        },
        {
          "label": "Italiano",
          "set": {
            "language": "italian"
          }
        },
        {
          "label": "Español",
          "set": {
            "language": "spanish"
          }
        }
      ],
      "defaults": {
        "language": "english"
      }
    },
    {
      "id": "intro",
      "label": "Start",
      "help": "What plays before the title screen.",
      "choices": [
        {
          "label": "Skip the logos",
          "set": {
            "skip_intro": "1"
          }
        },
        {
          "label": "Skip the opening movie too",
          "set": {
            "skip_intro": "2"
          }
        },
        {
          "label": "As on a DS",
          "set": {
            "skip_intro": "0"
          }
        }
      ],
      "defaults": {
        "skip_intro": "1"
      }
    },
    {
      "id": "battle_speed",
      "label": "Battle speed",
      "help": "Battles play this many times as fast (not while playing with friends).",
      "choices": [
        {
          "label": "Normal",
          "set": {
            "battle_speed": "1"
          }
        },
        {
          "label": "2x",
          "set": {
            "battle_speed": "2"
          }
        },
        {
          "label": "3x",
          "set": {
            "battle_speed": "3"
          }
        },
        {
          "label": "4x",
          "set": {
            "battle_speed": "4"
          }
        }
      ],
      "defaults": {
        "battle_speed": "1"
      }
    },
    {
      "id": "autosave",
      "label": "Autosave",
      "help": "Saves by itself every 10 minutes on the field, while free to walk.",
      "choices": [
        {
          "label": "Off",
          "set": {
            "autosave": "0"
          }
        },
        {
          "label": "On",
          "set": {
            "autosave": "1"
          }
        }
      ],
      "defaults": {
        "autosave": "0"
      }
    }
  ],
  "actions": [
    {
      "id": "saves",
      "label": "Game folder",
      "help": "Your save (dqix.sav), its backups and the game's settings.",
      "open": "saves"
    },
    {
      "id": "reports",
      "label": "Bug reports",
      "help": "The reports F10 makes in the game, to send with a bug.",
      "open": "reports"
    }
  ]
}
